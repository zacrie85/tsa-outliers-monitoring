generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id          String          @id @default(cuid())
  name        String
  description String?
  color       String          @default("#64b5f6")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  rows        MonitoringRow[]
  columns     CustomColumn[]
  charts      ChartConfig[]
  forms        FormConfig[]
}

model User {
  id         String   @id @default(cuid())
  username   String   @unique
  name       String
  password   String
  role       String   @default("EDITOR") // ADMIN, EDITOR, or VIEWER
  divisionId String?
  division   Division? @relation(fields: [divisionId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  logs       AuditLog[]
}

model Division {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String   @default("#6366f1")
  users     User[]
  columns   CustomColumn[]
  createdAt DateTime @default(now())
}

model MonitoringRow {
  id              String    @id @default(cuid())
  projectId       String?
  project         Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  orderNum        Int
  categoryBak     String   @default("")
  provinsi        String   @default("")
  kabupaten       String   @default("")
  kecamatan       String   @default("")
  kelurahan       String   @default("")
  kelRwSiteName   String   @default("")
  desaPerum       String   @default("")
  indexNum        Int      @default(0)
  homepass        Int      @default(0)
  odp             Int      @default(0)
  remarksTsa      String   @default("")
  klasifikasiTsa  String   @default("")
  picTsa          String   @default("")
  remarksJlm      String   @default("")
  customData      String   @default("{}") // JSON string for custom column values
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model CustomColumn {
  id         String    @id @default(cuid())
  projectId  String?
  project    Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name       String   // Internal key name
  label      String   // Display label
  order      Int       @default(0)
  isLocked   Boolean   @default(false)
  divisionId String?
  division   Division? @relation(fields: [divisionId], references: [id])
  createdAt  DateTime  @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  userName  String
  action    String // CELL_EDIT, ROW_ADD, ROW_DELETE, COL_ADD, COL_DELETE, COL_LOCK, COL_UNLOCK, LOGIN
  tableName String   @default("MonitoringRow")
  rowId     String?
  colKey    String?
  colLabel  String?
  oldValue  String?
  newValue  String?
  timestamp DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model FormConfig {
  id              String    @id @default(cuid())
  projectId       String?
  project         Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title           String
  description     String   @default("")
  fields          String   @default("[]") // JSON: [{key, label, type, required, placeholder}]
  referenceColumn String?  // column key used to link to existing rows
  referenceLabel  String?  // display label for the reference
  isActive        Boolean   @default(true)
  submissionCount Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model ChartConfig {
  id        String    @id @default(cuid())
  projectId String?
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String    @default("Chart")
  chartType String    @default("bar") // bar, line, pie, area, scatter, radar, treemap, funnel
  config    String    @default("{}") // JSON: { xAxis, yAxis, aggregation, filters }
  order     Int       @default(0)
}
